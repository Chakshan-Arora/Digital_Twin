{
  "openapi": "3.1.0",
  "info": {
    "title": "Human Digital Twin (HDT) Clearance API",
    "description": "Research prototype for uncertainty-aware 3D clearance analysis.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Get Health",
        "description": "Health check endpoint.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cases": {
      "get": {
        "summary": "Get Cases",
        "description": "List all available cases with their structures and roles.",
        "operationId": "get_cases_cases_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseSummary"
                  },
                  "type": "array",
                  "title": "Response Get Cases Cases Get"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}": {
      "get": {
        "summary": "Get Case",
        "description": "Get spatial metadata and structure list for a specific case in RAS coordinates.",
        "operationId": "get_case_cases__case_id__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/volume.nii.gz": {
      "get": {
        "summary": "Get Case Volume",
        "description": "Stream download the primary volumetric image as a NIfTI file.",
        "operationId": "get_case_volume_cases__case_id__volume_nii_gz_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/structures/{structure_name}/mask.nii.gz": {
      "get": {
        "summary": "Get Structure Mask",
        "description": "Stream download the structure binary mask as a NIfTI file.",
        "operationId": "get_structure_mask_cases__case_id__structures__structure_name__mask_nii_gz_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          },
          {
            "name": "structure_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Structure Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/structures/{structure_name}/stats": {
      "get": {
        "summary": "Get Structure Stats",
        "description": "Compute geometric and volumetric statistics for a structure.",
        "operationId": "get_structure_stats_cases__case_id__structures__structure_name__stats_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          },
          {
            "name": "structure_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Structure Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructureStats"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/structures/{structure_name}/mesh.obj": {
      "get": {
        "summary": "Get Structure Mesh",
        "description": "Generate 3D surface mesh (OBJ format) in RAS coordinates with outward winding.",
        "operationId": "get_structure_mesh_cases__case_id__structures__structure_name__mesh_obj_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          },
          {
            "name": "structure_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Structure Name"
            }
          },
          {
            "name": "max_triangles",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500000,
              "minimum": 1,
              "default": 150000,
              "title": "Max Triangles"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/clearance": {
      "post": {
        "summary": "Compute Clearance",
        "description": "Compute face-to-face signed clearance and closest points between structures.",
        "operationId": "compute_clearance_cases__case_id__clearance_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClearanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearanceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/uncertainty": {
      "post": {
        "summary": "Compute Uncertainty",
        "description": "Run Monte Carlo clearance uncertainty analysis under smooth boundary perturbation.",
        "operationId": "compute_uncertainty_cases__case_id__uncertainty_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UncertaintyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UncertaintyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/atlas": {
      "get": {
        "summary": "Get anatomical neural atlas",
        "description": "Returns the full educational neural atlas including dermatomes, ascending paths, and conditions.",
        "operationId": "get_atlas_atlas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Atlas"
                }
              }
            }
          }
        }
      }
    },
    "/atlas/dermatomes/{dermatome_id}": {
      "get": {
        "summary": "Get single dermatome by id",
        "description": "Returns metadata and ascending neural transmission path for a single dermatome.",
        "operationId": "get_dermatome_atlas_dermatomes__dermatome_id__get",
        "parameters": [
          {
            "name": "dermatome_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dermatome Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dermatome"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/atlas/conditions": {
      "get": {
        "summary": "Get list of clinical conditions",
        "description": "Returns common peripheral nerve and radicular clinical conditions mapped to affected dermatomes and roots.",
        "operationId": "get_conditions_atlas_conditions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Condition"
                  },
                  "type": "array",
                  "title": "Response Get Conditions Atlas Conditions Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Atlas": {
        "properties": {
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "description": "Educational disclaimer regarding research/prototype status"
          },
          "dermatomes": {
            "items": {
              "$ref": "#/components/schemas/Dermatome"
            },
            "type": "array",
            "title": "Dermatomes",
            "description": "Cutaneous dermatomes ordered anatomically"
          },
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array",
            "title": "Conditions",
            "description": "Representative clinical radicular/neuropathic conditions"
          }
        },
        "type": "object",
        "required": [
          "disclaimer",
          "dermatomes",
          "conditions"
        ],
        "title": "Atlas",
        "description": "Complete educational anatomical neural atlas."
      },
      "BBoxRAS": {
        "properties": {
          "min": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Min",
            "description": "Minimum bounding coordinates [x, y, z] in RAS mm"
          },
          "max": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Max",
            "description": "Maximum bounding coordinates [x, y, z] in RAS mm"
          }
        },
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "title": "BBoxRAS",
        "description": "Axis-aligned bounding box coordinates in physical RAS space."
      },
      "BodyZone": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "torso_band",
              "arm",
              "leg",
              "head_neck"
            ],
            "title": "Kind",
            "description": "General morphological zone"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Anatomical location description"
          },
          "y_fraction": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Y Fraction",
            "description": "Fraction of standing height [min, max] in [0, 1] for torso bands only"
          },
          "limb_part": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limb Part",
            "description": "Specific limb region (e.g. 'lateral forearm', 'lateral calf')"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "description"
        ],
        "title": "BodyZone",
        "description": "Anatomical body zone categorization for a dermatome."
      },
      "CaseDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique opaque case identifier"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human-readable case name"
          },
          "primary_image_name": {
            "type": "string",
            "title": "Primary Image Name",
            "description": "Name of the default/primary image modality",
            "default": "t1"
          },
          "spacing_mm": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Spacing Mm",
            "description": "Voxel spacing (sx, sy, sz) in millimetres under RAS convention"
          },
          "spacing_zyx_mm": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Spacing Zyx Mm",
            "description": "Internal voxel spacing in NumPy (z, y, x) order in mm"
          },
          "shape": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Shape",
            "description": "Volume dimensions in NumPy (z, y, x) order"
          },
          "shape_zyx": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Shape Zyx",
            "description": "Internal volume shape in NumPy (z, y, x) order"
          },
          "size": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Size",
            "description": "Volume dimensions (size_x, size_y, size_z) in voxels"
          },
          "origin_ras_mm": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Origin Ras Mm",
            "description": "Physical origin (x, y, z) in millimetres under RAS convention"
          },
          "direction_ras": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Direction Ras",
            "description": "3x3 direction cosine matrix in RAS space"
          },
          "structures": {
            "items": {
              "$ref": "#/components/schemas/StructureSummary"
            },
            "type": "array",
            "title": "Structures",
            "description": "List of segmented structures and roles"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary case-level metadata"
          },
          "coordinate_system": {
            "type": "string",
            "title": "Coordinate System",
            "description": "Spatial coordinate convention (always 'RAS')",
            "default": "RAS"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "spacing_mm",
          "spacing_zyx_mm",
          "shape",
          "shape_zyx",
          "size",
          "origin_ras_mm",
          "direction_ras",
          "structures"
        ],
        "title": "CaseDetail",
        "description": "Detailed spatial geometry and structure definitions for a case."
      },
      "CaseSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique opaque case identifier"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human-readable case name"
          },
          "structures": {
            "items": {
              "$ref": "#/components/schemas/StructureSummary"
            },
            "type": "array",
            "title": "Structures",
            "description": "List of segmented structures and roles"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "structures"
        ],
        "title": "CaseSummary",
        "description": "Summary representation of an imaging case."
      },
      "ClearanceRequest": {
        "properties": {
          "target_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Name",
            "description": "Target structure name"
          },
          "risk_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Name",
            "description": "Risk structure name"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target",
            "description": "Alternative alias for target_name"
          },
          "risk": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk",
            "description": "Alternative alias for risk_name"
          }
        },
        "type": "object",
        "title": "ClearanceRequest",
        "description": "Request payload for pairwise mask-to-mask clearance computation."
      },
      "ClearanceResponse": {
        "properties": {
          "clearance_mm": {
            "type": "number",
            "title": "Clearance Mm",
            "description": "Headline face-to-face clearance in mm. Positive = gap, 0 = touch, negative = penetration"
          },
          "convention": {
            "type": "string",
            "title": "Convention",
            "description": "Geometric distance convention applied",
            "default": "face_to_face_voxel_sets"
          },
          "closest_points_mm": {
            "additionalProperties": true,
            "type": "object",
            "title": "Closest Points Mm",
            "description": "Closest point coordinates in RAS physical millimetres and centre distance"
          },
          "surface_distance_stats": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Surface Distance Stats",
            "description": "Symmetric surface distance metrics (centre_min_mm, mean, hd95, max) in mm"
          },
          "resolution": {
            "$ref": "#/components/schemas/ResolutionBlock",
            "description": "Voxel grid resolution and directional extent along closest voxel pair"
          },
          "coordinate_system": {
            "type": "string",
            "title": "Coordinate System",
            "description": "Spatial coordinate convention (always 'RAS')",
            "default": "RAS"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "clearance_mm",
          "closest_points_mm",
          "surface_distance_stats",
          "resolution"
        ],
        "title": "ClearanceResponse",
        "description": "Response payload for pairwise mask-to-mask clearance."
      },
      "Condition": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique condition identifier, e.g. 'sciatica'"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Clinical diagnostic name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Pathophysiological overview"
          },
          "compressed_roots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Compressed Roots",
            "description": "Affected spinal nerve roots or cord levels"
          },
          "affected_dermatomes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Affected Dermatomes",
            "description": "Dermatomes experiencing sensory alteration"
          },
          "symptoms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Symptoms",
            "description": "Characteristic clinical symptoms"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "compressed_roots",
          "affected_dermatomes",
          "symptoms"
        ],
        "title": "Condition",
        "description": "Common peripheral nerve or radicular clinical condition."
      },
      "Dermatome": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique dermatome identifier, e.g. 'L5'"
          },
          "root": {
            "type": "string",
            "title": "Root",
            "description": "Spinal root level, e.g. 'L5'"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "description": "Plain-English cutaneous skin area"
          },
          "body_zone": {
            "$ref": "#/components/schemas/BodyZone",
            "description": "Zone category and boundary metadata"
          },
          "peripheral_nerve": {
            "type": "string",
            "title": "Peripheral Nerve",
            "description": "Major peripheral nerve innervating this territory"
          },
          "path": {
            "items": {
              "$ref": "#/components/schemas/NodeName"
            },
            "type": "array",
            "title": "Path",
            "description": "Ascending neural pathway from skin/joint into cord and up to cortex_S1"
          },
          "tract": {
            "type": "string",
            "title": "Tract",
            "description": "Ascending spinal tract (e.g. 'spinothalamic', 'dorsal column')"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "Optional clinical/anatomical notes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "root",
          "region",
          "body_zone",
          "peripheral_nerve",
          "path",
          "tract"
        ],
        "title": "Dermatome",
        "description": "Sensory cutaneous dermatome and its ascending neural transmission path."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Health check response."
      },
